@model ASP_Core.Models.Post
@{
	ViewData["Title"] = "Редагувати пост";
}

<h1>Редагувати пост</h1>

<form asp-action="Edit" method="post">
	<input type="hidden" asp-for="Id" />
	<div class="mb-3">
		<label class="form-label">Заголовок</label>
		<input asp-for="Title" class="form-control" />
	</div>
	<div class="mb-3">
		<label class="form-label">Короткий текст</label>
		<textarea asp-for="Summary" class="form-control" rows="3"></textarea>
	</div>
	<div class="mb-3">
		<label class="form-label">Зміст</label>
		<textarea asp-for="Content" class="form-control" rows="6"></textarea>
	</div>
	<button class="btn btn-primary">Зберегти</button>
	<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Скасувати</a>
	@Html.AntiForgeryToken()
</form>
