@model ASP_Core.Models.Post
@{
	ViewData["Title"] = Model?.Title ?? "Пост";
}

@if (Model == null)
{
	<div class="alert alert-warning">Пост не знайдено.</div>
}
else
{
	<h1>@Model.Title</h1>
	<p class="text-muted">@Model.Author — @Model.CreatedAt.ToLocalTime()</p>
	<p>@Model.Content</p>

	<hr />
	<h5>Коментарі</h5>
	@foreach(var c in Model.Comments)
	{
		<div class="border rounded p-2 mb-2">
			<small class="text-muted">@c.Author — @c.CreatedAt.ToLocalTime()</small>
			<p>@c.Text</p>
			@if (User?.Identity?.IsAuthenticated == true)
			{
				<form asp-controller="Comments" asp-action="Delete" method="post" class="d-inline">
					<input type="hidden" name="id" value="@c.Id" />
					<button class="btn btn-sm btn-danger" onclick="return confirm('Видалити коментар?');">Видалити</button>
					@Html.AntiForgeryToken()
				</form>
			}
		</div>
	}

	@if (User?.Identity?.IsAuthenticated == true)
	{
		<form asp-controller="Comments" asp-action="Create" method="post">
			<input type="hidden" name="postId" value="@Model.Id" />
			<div class="mb-2">
				<textarea name="text" class="form-control" placeholder="Ваш коментар"></textarea>
			</div>
			<button class="btn btn-primary">Додати коментар</button>
			@Html.AntiForgeryToken()
		</form>
	}
	else
	{
		<p><a asp-controller="Account" asp-action="Login">Увійдіть</a>, щоб залишити коментар.</p>
	}

	<p class="mt-3">
		@if (User?.Identity?.IsAuthenticated == true)
		{
			<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Редагувати</a>
			<form asp-action="Delete" method="post" class="d-inline ms-2">
				<input type="hidden" name="id" value="@Model.Id" />
				<button class="btn btn-danger" onclick="return confirm('Видалити пост?');">Видалити пост</button>
				@Html.AntiForgeryToken()
			</form>
		}
		<a asp-action="Index" class="btn btn-link">Назад</a>
	</p>
}
