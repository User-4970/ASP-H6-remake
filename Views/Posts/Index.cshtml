@model IEnumerable<ASP_Core.Models.Post>
@{
	ViewData["Title"] = "Усі пости";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1>Стрічка постів</h1>
	<form class="d-flex" method="get" asp-action="Index">
		<input name="author" value="@ViewBag.Search" class="form-control me-2" placeholder="Пошук за автором" />
		<button class="btn btn-outline-primary">Пошук</button>
	</form>
</div>

@if (!string.IsNullOrEmpty(TempData["Message"] as string))
{
	<div class="alert alert-info">@TempData["Message"]</div>
}

@foreach(var post in Model)
{
	<div class="card mb-3">
		<div class="card-body">
			<h4>@post.Title</h4>
			<small class="text-muted">@post.Author — @post.CreatedAt.ToLocalTime()</small>
			<p class="mt-2">@post.Summary</p>
			<a asp-action="Details" asp-route-id="@post.Id" class="btn btn-primary">Читати</a>
		</div>
	</div>
}
