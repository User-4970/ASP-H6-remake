@model ASP_Core.Models.Game
@{
	ViewData["Title"] = Model != null ? Model.Title : "Details";
}

@if (Model == null)
{
	<div class="alert alert-warning">Гру не знайдено.</div>
	<p><a asp-action="Index" class="btn btn-secondary">Назад</a></p>
}
else
{
	<h1>@Model.Title</h1>
	<p><strong>Genre:</strong> @Model.Genre</p>
	<p><strong>Rating:</strong> @String.Format("{0:0.0}", Model.Rating)</p>
	<p><strong>Completed:</strong> @(Model.IsCompleted ? "Yes" : "No")</p>
	<p><a asp-action="Index" class="btn btn-secondary">Back to list</a></p>
}
