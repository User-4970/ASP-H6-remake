@model IEnumerable<ASP_Core.Models.Game>
@{
	ViewData["Title"] = "Completed Games";
}

<h1>Completed Games</h1>

@if (!Model.Any())
{
	<div class="alert alert-info">Немає пройдених ігор.</div>
}
else
{
	<ul class="list-group">
	@foreach(var g in Model)
	{
		<li class="list-group-item d-flex justify-content-between align-items-center">
			<div>
				<strong>@g.Title</strong> — @g.Genre
			</div>
			<div>
				<a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@g.Id">Details</a>
			</div>
		</li>
	}
	</ul>
}

<p class="mt-3"><a asp-action="Index" class="btn btn-secondary">Back to all</a></p>
